<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>headroom-credential-helper</AssemblyName>
    <RootNamespace>Headroom.CredentialHelper</RootNamespace>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Services/IProviderCookieReader.cs" Link="Services/IProviderCookieReader.cs" />
    <Compile Include="../Services/BrowserCookieDatabaseSnapshot.cs" Link="Services/BrowserCookieDatabaseSnapshot.cs" />
    <Compile Include="../Services/WindowsBrowserCookieReader.cs" Link="Services/WindowsBrowserCookieReader.cs" />
    <Compile Include="../Services/DebugService.cs" Link="Services/DebugService.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.29" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>
