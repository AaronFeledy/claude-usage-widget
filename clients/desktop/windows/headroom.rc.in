#include <windows.h>

IDI_ICON1 ICON "@HEADROOM_WINDOWS_ICON@"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "@HEADROOM_WINDOWS_MANIFEST@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Headroom contributors\0"
      VALUE "FileDescription", "Headroom AI usage monitor\0"
      VALUE "FileVersion", "0.1.0\0"
      VALUE "InternalName", "headroom\0"
      VALUE "OriginalFilename", "headroom.exe\0"
      VALUE "ProductName", "Headroom\0"
      VALUE "ProductVersion", "0.1.0\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
